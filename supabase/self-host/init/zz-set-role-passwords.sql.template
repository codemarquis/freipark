-- Runs once, on first initialization of the db volume only (Postgres skips
-- /docker-entrypoint-initdb.d/ entirely on a non-empty data directory).
--
-- supabase/postgres creates authenticator and supabase_auth_admin
-- passwordless — POSTGRES_PASSWORD only sets the postgres superuser's
-- password. rest (PostgREST) and auth (GoTrue) connect as these two roles
-- respectively, so they need explicit passwords set here. Confirmed via
-- direct inspection (pg_authid.rolpassword IS NULL for both before this
-- script existed) rather than assumed.
ALTER ROLE authenticator WITH PASSWORD '${SUPABASE_SELFHOSTED_DB_PASSWORD}';
ALTER ROLE supabase_auth_admin WITH PASSWORD '${SUPABASE_SELFHOSTED_DB_PASSWORD}';
