{
  "expo": {
    "name": "FreiPark",
    "slug": "freipark",
    "scheme": "freipark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.freipark.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "maps",
          "comgooglemaps"
        ],
        "NSLocationWhenInUseUsageDescription": "FreiPark uses your location to show nearby parking spots and directions to the one you select."
      }
    },
    "android": {
      "package": "com.freipark.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FreiPark uses your location to show nearby parking spots and directions to the one you select."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "invest-hub"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a7799d03-5f4e-4e1f-aaee-1cae1591d315"
      }
    },
    "owner": "invest-hub"
  }
}
