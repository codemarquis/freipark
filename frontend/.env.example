# Supabase — get these from app.supabase.com → Settings → API
# The publishable/anon key is safe to expose; RLS enforces access control
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>

# Cloudflare R2 public URL for berlin.pmtiles
# Format: https://pub-<hash>.r2.dev/berlin.pmtiles
EXPO_PUBLIC_PMTILES_URL=https://pub-<hash>.r2.dev/berlin.pmtiles

# FastAPI backend (routing proxy to self-hosted OSRM — see SPEC-infra.md § Routing infra)
EXPO_PUBLIC_API_URL=https://api.freipark.com

# OPTIONAL. Cloudflare R2 mirror of the map's font glyphs — works around a
# MapLibre Native bug where spaced font-stack names in the glyphs URL get
# corrupted (see SPEC-map.md § Glyph Hosting). Omit to fall back to
# Protomaps' hosted assets (works, but not this project's own infra and
# was the actual root cause of blank/label-less map renders).
# Format must keep the {fontstack}/{range}.pbf template literally:
# EXPO_PUBLIC_GLYPHS_URL=https://pub-<hash>.r2.dev/fonts/{fontstack}/{range}.pbf
